PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret
DB_PATH=./data/dauto.db

# Orígenes permitidos por CORS, separados por comas.
# - Vacío en desarrollo: se permite solo http://localhost:5173 (el frontend de Vite).
# - Vacío en producción: no se permite ningún origen externo.
# Nunca se responde con "*". Ejemplo de producción:
# CORS_ORIGINS=https://dauto.example.com
CORS_ORIGINS=

# Opcionales
# BCRYPT_ROUNDS=12     # factor de trabajo del hash; en producción el mínimo efectivo es 10
# AUTH_RATE_LIMIT=20   # intentos de login/registro por IP cada 15 minutos
# TRUST_PROXY=1        # nº de proxies delante del servidor (necesario tras un balanceador)
