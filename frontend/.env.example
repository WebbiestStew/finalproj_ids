# Leave empty: the app talks to the API on its own origin (Vite proxies /api in dev, the
# backend serves the built app in production). Set it only if the API is on another domain,
# e.g. VITE_API_URL=https://api.dauto.example.com  (then also set CORS_ORIGINS on the backend).
VITE_API_URL=

# Optional: where the dev server proxies /api (default http://localhost:3000)
# VITE_PROXY_TARGET=http://localhost:3000
