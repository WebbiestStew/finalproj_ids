# Variables de despliegue (docker compose y plataformas de hosting).
# `npm run setup` crea un .env con valores generados; esto es solo la referencia.

# OBLIGATORIA. Firma los tokens de sesión. Genera una con:  openssl rand -hex 32
JWT_SECRET=

# Crea este administrador la primera vez que arranca el servidor (si no existe).
# La contraseña debe tener al menos 10 caracteres.
ADMIN_EMAIL=admin@dauto.com
ADMIN_PASSWORD=

# true = agrega 2 concesionarias y 12 autos de ejemplo si faltan.
SEED_DEMO=true
# Opcional: contraseña para entrar como las concesionarias demo.
# Sin ella esas cuentas existen pero nadie puede iniciar sesión con ellas (lo seguro en público).
# DEMO_PASSWORD=

# Detrás de un balanceador/proxy (Render, Fly, nginx...): nº de proxies, normalmente 1.
# TRUST_PROXY=1
# Puerto publicado por docker compose (por defecto 3000)
# PORT=3000
